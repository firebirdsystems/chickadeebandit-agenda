{
  "id": "agenda",
  "name": "Agenda",
  "version": "1.1.0",
  "description": "Run structured meetings for your household or organization. Collect agenda items, track action items, and capture notes.",
  "entrypoint": "index.html",
  "runtime": "static",
  "storage": "db",
  "category": "general",
  "tags": ["meetings", "agenda", "action-items", "notes"],
  "contexts": ["household", "shared_space"],
  "data_access": {
    "reads": ["family.members", "family.groups"],
    "writes": []
  },
  "exports": ["calendar_events"],
  "agenda": [
    {
      "kind": "event",
      "label": "Meetings",
      "source": {
        "kind": "sql",
        "query": "SELECT id AS id, title AS title, scheduled_at AS when_at, (status = 'completed') AS done FROM app_agenda__meetings WHERE substr(scheduled_at, 1, 10) = :today ORDER BY scheduled_at LIMIT 10"
      }
    },
    {
      "kind": "task",
      "label": "Action items",
      "source": {
        "kind": "sql",
        "query": "SELECT id AS id, title AS title, due_date AS when_at, assigned_to AS member_id FROM app_agenda__action_items WHERE due_date = :today AND status = 'open' ORDER BY created_at LIMIT 10"
      }
    }
  ],
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS n FROM app_agenda__action_items WHERE assigned_to = :me AND status = 'open' LIMIT 1"
    },
    "display": {
      "template": "badge",
      "count": "n",
      "label": "action items on you",
      "severity": "warn"
    }
  },
  "publishes": [
    "agenda.meeting_scheduled"
  ],
  "publish_acls": {
    "agenda.meeting_scheduled": { "require_role": "member" }
  },
  "row_policies": {
    "meeting_groups": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "audience",
      "everyone_values": ["everyone"],
      "adult_values": ["adults"],
      "write_owner_only": true,
      "column_write_acls": {
        "audience": { "writable_by": ["adult"], "actions": ["update"] },
        "created_by": { "writable_by": ["adult"], "actions": ["update"] },
        "created_at": { "writable_by": ["adult"], "actions": ["update"] }
      }
    },
    "meetings": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "audience",
      "everyone_values": ["everyone"],
      "adult_values": ["adults"],
      "write_owner_only": false,
      "frozen_when": { "status_column": "status", "locked_values": ["completed"] },
      "column_write_acls": {
        "audience": { "writable_by": ["adult"], "actions": ["update"] },
        "group_id": { "writable_by": ["adult"], "actions": ["update"] },
        "created_by": { "writable_by": ["adult"], "actions": ["update"] },
        "created_at": { "writable_by": ["adult"], "actions": ["update"] }
      }
    },
    "agenda_items": {
      "kind": "owner_or_visibility",
      "member_column": "submitted_by",
      "visibility_column": "audience",
      "everyone_values": ["everyone"],
      "adult_values": ["adults"],
      "write_owner_only": false,
      "column_write_acls": {
        "audience": { "writable_by": ["adult"], "actions": ["update"] },
        "meeting_id": { "writable_by": ["adult"], "actions": ["update"] },
        "submitted_by": { "writable_by": ["adult"], "actions": ["update"] },
        "created_at": { "writable_by": ["adult"], "actions": ["update"] }
      }
    },
    "action_items": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "audience",
      "everyone_values": ["everyone"],
      "adult_values": ["adults"],
      "write_owner_only": false,
      "column_write_acls": {
        "audience": { "writable_by": ["adult"], "actions": ["update"] },
        "meeting_id": { "writable_by": ["adult"], "actions": ["update"] },
        "created_by": { "writable_by": ["adult"], "actions": ["update"] },
        "created_at": { "writable_by": ["adult"], "actions": ["update"] }
      }
    }
  },
  "db_plaintext_columns": ["assigned_to"],
  "member_references": {
    "meeting_groups": { "column": "created_by", "on_removed": "keep" },
    "meetings": { "column": "created_by", "on_removed": "keep" },
    "agenda_items": { "column": "submitted_by", "on_removed": "keep" },
    "action_items": [
      { "column": "created_by", "on_removed": "keep" },
      { "column": "assigned_to", "on_removed": "null" }
    ]
  },
  "store_acls": {
    "calendar_events": {
      "write": { "require_role": "adult" }
    }
  },
  "resource_limits": {
    "max_db_bytes": 10485760
  },
  "nav": {
    "label": "Agenda"
  },
  "widget": {
    "label": "Agenda",
    "size": "medium"
  },
  "icon": "📋",
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["upcoming_meetings", "open_action_items"]
  }
}
